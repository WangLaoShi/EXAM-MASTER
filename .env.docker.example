# 复制为项目根目录 .env 后供 docker compose 使用
# cp .env.docker.example .env

APP_NAME=EXAM-MASTER
APP_VERSION=2.0.0
DEBUG=false

# 生产环境务必修改为随机长字符串
SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_SECRET_KEY=change-me-to-another-long-random-jwt-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

DATABASE_URL=sqlite:///./databases/main.db
QUESTION_BANK_DATABASE_URL=sqlite:///./databases/question_bank.db

UPLOAD_DIR=./storage/uploads
RESOURCE_DIR=./storage/resources
QUESTION_BANK_DIR=./storage/question_banks
MAX_UPLOAD_SIZE=52428800

# 对外访问域名（按需追加）
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# 宿主机映射端口（docker-compose 读取，非容器内）
EXAM_MASTER_PORT=8000
